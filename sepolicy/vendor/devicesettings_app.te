allow devicesettings_app sysfs_therm:dir search;
allow devicesettings_app sysfs_therm:file { write };
allow devicesettings_app sysfs_therm:file { getattr open read };
allow devicesettings_app sysfs_power_supply:dir search;
allow devicesettings_app sysfs_power_supply:file r_file_perms;
allow devicesettings_app sysfs_gpu:dir search;
allow devicesettings_app sysfs_gpu:file r_file_perms;
allow devicesettings_app sysfs_batteryinfo:dir search;
allow devicesettings_app sysfs_batteryinfo:file r_file_perms;

allow devicesettings_app proc_stat:file { read open getattr };
